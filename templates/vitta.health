<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vitta Health</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0F1E3D; --blue:#1D4ED8; --blue-dark:#1D4ED8; --blue-soft:#EEF3FC;
    --bg:#FFFFFF; --panel:#F7F8FA; --ink:#1C2331; --ink-soft:#5B6472; --line:#E2E5EB; --white:#FFFFFF;
  }
  *{ box-sizing:border-box; }
  body{ margin:0; font-family:'Inter', sans-serif; color:var(--ink); background:var(--bg); line-height:1.55; }
  h1,h2,h3{ font-family:'Inter', sans-serif; font-weight:700; letter-spacing:-0.02em; color:var(--navy); margin:0; }
  a{ color:inherit; text-decoration:none; }
  .wrap{ max-width:1120px; margin:0 auto; padding:0 40px; }
  @media(max-width:720px){ .wrap{ padding:0 20px; } }
  em.hl{ font-style:normal; color:var(--blue-dark); }

  .btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; background:var(--navy); color:var(--white); font-weight:600; font-size:15px; padding:13px 24px; border-radius:8px; border:none; cursor:pointer; transition:background .15s ease; }
  .btn:hover{ background:#050D1F; }
  .link-arrow{ font-weight:600; font-size:15px; color:var(--navy); display:inline-flex; align-items:center; gap:6px; border-bottom:1px solid var(--line); padding-bottom:2px; }
  .link-arrow:hover{ border-color:var(--navy); }

  .check-line{ display:flex; align-items:center; justify-content:center; gap:20px; flex-wrap:wrap; font-size:13px; color:var(--ink-soft); margin-top:18px; }
  .check-line span{ display:flex; align-items:center; gap:6px; }
  .check-line svg{ color:#227A3E; flex-shrink:0; }

  .logo{ display:flex; align-items:center; gap:9px; font-weight:700; font-size:19px; color:var(--navy); letter-spacing:-0.01em; }
  .logo-mark{ width:26px; height:26px; border-radius:6px; background:var(--navy); position:relative; flex-shrink:0; }
  .logo-mark::before{ content:''; position:absolute; width:12px; height:12px; border:2px solid var(--white); border-radius:3px; top:5px; left:5px; }

  header{ position:sticky; top:0; z-index:50; background:rgba(255,255,255,0.94); backdrop-filter:blur(6px); border-bottom:1px solid var(--line); }
  nav.wrap{ display:flex; align-items:center; justify-content:space-between; height:72px; }
  .nav-links{ display:flex; gap:30px; font-size:14.5px; font-weight:500; color:var(--ink-soft); }
  .nav-links a:hover{ color:var(--navy); }
  @media(max-width:860px){ .nav-links{ display:none; } }

  section{ padding:84px 0; }
  @media(max-width:720px){ section{ padding:52px 0; } }

  .hero{ padding-top:56px; padding-bottom:56px; background:radial-gradient(circle at 50% 0%, #EEF3FC 0%, var(--panel) 55%, var(--panel) 100%); border-bottom:1px solid var(--line); }
  .hero .wrap{ text-align:center; }
  h1.headline{ font-size:44px; line-height:1.15; letter-spacing:-0.02em; font-weight:700; margin-bottom:18px; max-width:760px; margin-left:auto; margin-right:auto; }
  @media(max-width:720px){ h1.headline{ font-size:30px; } }
  .sub{ font-size:17px; color:var(--ink-soft); max-width:560px; margin:0 auto 28px; line-height:1.6; }
  .hero-ctas{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; align-items:center; }

  .calc-wrap{ display:flex; justify-content:center; margin-top:44px; }
  .calc-card{ width:100%; max-width:340px; background:var(--white); border:1px solid var(--line); border-radius:18px; padding:30px; box-shadow:0 1px 2px rgba(15,30,61,0.05), 0 24px 48px -22px rgba(15,30,61,0.28); text-align:left; }
  .calc-icon{ width:42px; height:42px; border-radius:10px; background:var(--blue-soft); display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
  .calc-headline{ font-size:17px; font-weight:800; color:var(--navy); margin-bottom:20px; letter-spacing:-0.01em; line-height:1.3; }
  .calc-label{ font-size:14px; font-weight:700; color:var(--navy); margin-bottom:14px; }
  .calc-slider{ width:100%; accent-color:var(--blue-dark); height:4px; margin:0; cursor:pointer; }
  .calc-scale{ display:flex; justify-content:space-between; font-size:11px; color:var(--ink-soft); margin-top:6px; }
  .calc-value{ font-size:13px; font-weight:600; color:var(--ink); margin-top:12px; }
  .calc-divider{ border-top:1px solid var(--line); margin:18px 0; }
  .calc-result{ text-align:center; background:var(--panel); border-radius:10px; padding:20px 14px; }
  .calc-result-num{ font-size:34px; font-weight:800; color:var(--blue-dark); line-height:1; letter-spacing:-0.02em; }
  .calc-result-label{ font-size:12.5px; color:var(--ink-soft); margin-top:6px; }
  .calc-source{ font-size:10.5px; color:var(--ink-soft); margin-top:14px; line-height:1.5; text-align:center; }

  .reframe{ text-align:center; }
  .reframe h2{ font-size:32px; max-width:680px; margin:0 auto 16px; line-height:1.3; }
  .reframe p{ color:var(--ink-soft); font-size:16px; max-width:560px; margin:0 auto 28px; line-height:1.6; }

  .vh-reveal{ opacity:0; transform:translateY(24px); transition:opacity .6s ease, transform .6s ease; }
  .vh-reveal.vh-visible{ opacity:1; transform:translateY(0); }

  .section-head{ max-width:620px; margin:0 auto 52px; text-align:center; }
  .section-head h2{ font-size:32px; margin-bottom:12px; }
  .section-head p{ color:var(--ink-soft); font-size:16px; margin:0; }

  .card{ background:var(--white); border:1px solid var(--line); border-radius:16px; padding:28px; box-shadow:0 1px 2px rgba(15,30,61,0.04), 0 18px 32px -22px rgba(15,30,61,0.28); transition:transform .25s ease, box-shadow .25s ease; }
  .card:hover{ transform:translateY(-4px); box-shadow:0 1px 2px rgba(15,30,61,0.05), 0 26px 44px -20px rgba(15,30,61,0.32); }

  .module{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; margin-bottom:96px; }
  .module:last-child{ margin-bottom:0; }
  .module.reverse .module-visual{ order:2; }
  @media(max-width:900px){ .module{ grid-template-columns:1fr; gap:32px; } .module.reverse .module-visual{ order:0; } }
  .module-kicker{ font-size:12.5px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--blue-dark); margin-bottom:12px; }
  .module h3{ font-size:26px; margin-bottom:14px; line-height:1.25; }
  .module p.desc{ color:var(--ink-soft); font-size:15.5px; margin-bottom:20px; line-height:1.65; }
  .module-checks{ list-style:none; padding:0; margin:0 0 24px 0; display:flex; flex-direction:column; gap:11px; }
  .module-checks li{ display:flex; align-items:center; gap:10px; font-size:14.5px; font-weight:600; color:var(--ink); }
  .module-checks svg{ color:#227A3E; flex-shrink:0; }
  .module-visual{ display:flex; justify-content:center; }
  .app-shell{ background:var(--white); border:1px solid var(--line); border-radius:14px; overflow:hidden; width:100%; max-width:420px; box-shadow:0 1px 2px rgba(15,30,61,0.06), 0 34px 64px -24px rgba(15,30,61,0.32); }
  .app-topbar{ display:flex; align-items:center; gap:10px; padding:11px 16px; border-bottom:1px solid var(--line); background:var(--panel); }
  .app-topbar .dots{ display:flex; gap:6px; flex-shrink:0; }
  .app-topbar .dots span{ width:8px; height:8px; border-radius:50%; background:#D8DCE3; }
  .app-topbar .app-url{ flex:1; background:var(--white); border:1px solid var(--line); border-radius:6px; padding:4px 10px; font-size:11px; color:var(--ink-soft); }
  .app-body{ display:flex; min-height:290px; }
  .app-sidebar{ width:54px; background:var(--navy); display:flex; flex-direction:column; align-items:center; padding:16px 0; gap:16px; flex-shrink:0; }
  .app-sidebar .side-icon{ width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; color:#7A87A8; }
  .app-sidebar .side-icon.active{ background:rgba(255,255,255,0.12); color:#FFFFFF; }
  .app-main{ flex:1; padding:20px; min-width:0; }
  .app-main .am-title{ font-size:11px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:14px; }
  .app-tabs{ display:flex; gap:16px; border-bottom:1px solid var(--line); margin-bottom:14px; }
  .app-tabs span{ font-size:12px; font-weight:600; color:var(--ink-soft); padding-bottom:8px; }
  .app-tabs span.active{ color:var(--navy); border-bottom:2px solid var(--blue-dark); }
  .am-field-label{ font-size:10px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:5px; }
  .am-field-text{ font-size:12.5px; color:var(--ink); line-height:1.6; margin-bottom:14px; }
  .am-row{ display:flex; align-items:center; gap:10px; padding:10px 0; border-top:1px solid var(--line); }
  .am-row:first-child{ border-top:none; }
  .am-avatar{ width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#FFFFFF; font-size:11px; font-weight:700; flex-shrink:0; }
  .am-row-name{ font-size:13px; font-weight:600; color:var(--navy); flex:1; }
  .am-row-meta{ font-size:11.5px; color:var(--ink-soft); }
  .am-tag{ font-size:10.5px; font-weight:700; padding:3px 9px; border-radius:100px; flex-shrink:0; }
  .am-tag.green{ background:#EFF6ED; color:#227A3E; }
  .am-tag.amber{ background:#FEF3C7; color:#92400E; }
  .am-rx-row{ display:flex; align-items:center; justify-content:space-between; padding:9px 0; border-top:1px solid var(--line); font-size:12.5px; color:var(--ink); }
  .am-rx-row:first-child{ border-top:none; }
  .am-warning{ margin-top:10px; padding:9px 12px; background:#FEF2F2; border:1px solid #FCA5A5; border-radius:8px; font-size:11.5px; font-weight:600; color:#B91C1C; }

  .how-layout{ display:grid; grid-template-columns:0.85fr 1.15fr; gap:64px; align-items:center; }
  @media(max-width:860px){
    .how-layout{ grid-template-columns:1fr; gap:28px; }
    .phone-shell{ width:240px !important; }
    .phone-screen{ height:380px !important; padding:28px 18px 20px !important; }
    .phone-mic-wrap{ width:88px !important; height:88px !important; margin-bottom:18px !important; }
    .mic-btn{ width:58px !important; height:58px !important; }
    .phone-waveform{ height:28px !important; margin-bottom:14px !important; }
    .note-preview{ padding:14px !important; margin-bottom:12px !important; }
    .note-preview .text{ font-size:12px !important; line-height:1.55 !important; }
    .ready-check{ font-size:12px !important; }
    .phone-status-text{ font-size:13px !important; margin-bottom:14px !important; }
    .how-steps{ gap:20px !important; }
    .how-step{ padding:16px !important; }
    .how-step h3{ font-size:16.5px !important; }
    .how-step p{ font-size:13.5px !important; }
  }
  .how-phone{ display:flex; justify-content:center; position:relative; }
  .how-phone::before{ content:''; position:absolute; width:280px; height:280px; border-radius:50%; background:radial-gradient(circle, rgba(29,78,216,0.16), transparent 70%); top:20px; z-index:0; }
  .how-steps{ display:flex; flex-direction:column; gap:36px; }
  .how-step{ display:flex; gap:20px; padding:22px; border-radius:14px; border:1px solid transparent; opacity:0.45; transition:background .3s ease, border-color .3s ease, opacity .3s ease; }
  .how-step.active{ background:var(--panel); border-color:var(--line); opacity:1; }
  .how-step-num{ width:36px; height:36px; border-radius:50%; border:1.5px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:700; color:var(--ink-soft); flex-shrink:0; transition:background .3s ease, border-color .3s ease, color .3s ease; }
  .how-step.active .how-step-num{ background:var(--blue-dark); border-color:var(--blue-dark); color:#FFFFFF; }
  .how-step h3{ font-size:19px; margin-bottom:7px; }
  .how-step p{ font-size:15px; color:var(--ink-soft); margin:0; line-height:1.55; }

  .phone-shell{ width:280px; background:#111722; border-radius:38px; padding:11px; box-shadow:0 1px 2px rgba(15,30,61,0.08), 0 32px 64px -20px rgba(15,30,61,0.45); position:relative; z-index:1; }
  .phone-notch{ position:absolute; top:11px; left:50%; transform:translateX(-50%); width:105px; height:18px; background:#111722; border-radius:0 0 13px 13px; z-index:2; }
  .phone-screen{ background:var(--white); border-radius:30px; overflow:hidden; position:relative; height:460px; display:flex; flex-direction:column; align-items:center; padding:36px 26px 28px; }
  .phone-appname{ font-size:13.5px; font-weight:700; color:var(--navy); letter-spacing:0.02em; margin-bottom:3px; }
  .phone-patient{ font-size:12.5px; color:var(--ink-soft); margin-bottom:8px; }
  .phone-stage{ flex:1; width:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .phone-stage-panel{ display:none; width:100%; flex-direction:column; align-items:center; }
  .phone-stage-panel.visible{ display:flex; }
  .phone-mic-wrap{ position:relative; width:112px; height:112px; display:flex; align-items:center; justify-content:center; margin-bottom:26px; }
  .mic-ring{ position:absolute; width:100%; height:100%; border-radius:50%; border:1.5px solid var(--blue-dark); opacity:0; animation:vhMicRing 2.4s ease-out infinite; }
  .mic-ring.ring2{ animation-delay:1.2s; }
  .mic-btn{ width:72px; height:72px; border-radius:50%; background:var(--blue-dark); display:flex; align-items:center; justify-content:center; box-shadow:0 8px 20px -4px rgba(29,78,216,0.55); }
  .phone-waveform{ display:flex; align-items:center; justify-content:center; gap:5px; height:36px; margin-bottom:18px; }
  .phone-waveform span{ width:3px; border-radius:2px; background:var(--blue-dark); opacity:0.85; animation:vhPhoneWave 1s ease-in-out infinite; }
  .phone-rec-label{ display:flex; align-items:center; gap:7px; font-size:12px; font-weight:600; color:var(--ink-soft); }
  .phone-rec-label .rec-dot{ width:6px; height:6px; border-radius:50%; background:#DC2626; animation:vhPulseRec 1.6s infinite; }
  .phone-icon-circle{ width:64px; height:64px; border-radius:50%; background:var(--blue-soft); display:flex; align-items:center; justify-content:center; margin-bottom:22px; }
  .phone-status-text{ font-size:14px; font-weight:600; color:var(--navy); margin-bottom:18px; }
  .dots-row{ display:flex; gap:5px; margin-bottom:14px; }
  .dots-row span{ width:6px; height:6px; border-radius:50%; background:var(--blue-dark); animation:vhDotBounce 1.2s ease-in-out infinite; }
  .dots-row span:nth-child(2){ animation-delay:0.15s; }
  .dots-row span:nth-child(3){ animation-delay:0.3s; }
  .note-preview{ width:100%; text-align:left; background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:16px; margin-bottom:16px; }
  .note-preview .label{ font-size:10px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:5px; }
  .note-preview .text{ font-size:12px; color:var(--ink); line-height:1.55; }
  .ready-check{ display:flex; align-items:center; gap:7px; color:#227A3E; font-weight:700; font-size:12.5px; }
  @keyframes vhFadeInUp{ from{ opacity:0; transform:translateY(20px); } to{ opacity:1; transform:translateY(0); } }
  @keyframes vhMicRing{ 0%{ transform:scale(0.7); opacity:0.5; } 100%{ transform:scale(1.5); opacity:0; } }
  @keyframes vhPhoneWave{ 0%,100%{ height:6px; } 50%{ height:26px; } }
  @keyframes vhPulseRec{ 0%,100%{ opacity:1; } 50%{ opacity:0.25; } }
  @keyframes vhDotBounce{ 0%,80%,100%{ transform:translateY(0); opacity:0.4; } 40%{ transform:translateY(-5px); opacity:1; } }

  .benefit-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  @media(max-width:860px){ .benefit-grid{ grid-template-columns:1fr 1fr; } }
  @media(max-width:500px){ .benefit-grid{ grid-template-columns:1fr; } }
  .benefit-icon{ width:40px; height:40px; border-radius:9px; background:var(--blue-soft); display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
  .card h3{ font-size:15px; margin-bottom:6px; }
  .card p{ font-size:13.5px; color:var(--ink-soft); margin:0; line-height:1.6; }

  .audience-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  @media(max-width:860px){ .audience-grid{ grid-template-columns:1fr; } }
  .audience-card h3{ font-size:16px; margin-bottom:6px; }

  .testi{ background:var(--white); border:1px solid var(--line); border-radius:18px; padding:40px; max-width:640px; margin:0 auto; text-align:center; box-shadow:0 1px 2px rgba(15,30,61,0.04), 0 24px 48px -26px rgba(15,30,61,0.3); }
  .testi p.quote{ font-size:17px; font-style:italic; color:var(--ink); margin:0 0 16px 0; line-height:1.6; }
  .testi p.who{ font-weight:700; color:var(--navy); font-size:13.5px; margin:0; }

  .cta-banner{ background:var(--navy); border-radius:16px; padding:56px 44px; text-align:center; }
  .cta-banner h2{ color:var(--white); font-size:28px; margin-bottom:12px; }
  .cta-banner p{ color:#AEB8CC; font-size:15px; margin-bottom:24px; }
  .cta-banner .check-line{ color:#AEB8CC; }
  .cta-banner .check-line svg{ color:#5FD08A; }

  .faq-item{ border-bottom:1px solid var(--line); padding:20px 0; }
  .faq-item summary{ cursor:pointer; font-weight:600; font-size:15.5px; color:var(--navy); list-style:none; display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .faq-item summary::-webkit-details-marker{ display:none; }
  .faq-item summary::after{ content:'+'; font-size:22px; color:var(--ink-soft); font-weight:400; flex-shrink:0; }
  .faq-item[open] summary::after{ content:'\2212'; }
  .faq-item p{ color:var(--ink-soft); font-size:14.5px; margin:12px 0 0 0; line-height:1.65; max-width:680px; }
  .faq-wrap{ max-width:760px; margin:0 auto; }

  footer{ background:var(--navy); color:#AEB8CC; padding-top:52px; border-top:1px solid rgba(255,255,255,0.08); }
  .foot-grid{ display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:36px; padding-bottom:36px; border-bottom:1px solid rgba(255,255,255,0.1); }
  @media(max-width:720px){ .foot-grid{ grid-template-columns:1fr; gap:26px; } }
  .foot-brand .logo{ color:var(--white); margin-bottom:12px; }
  .foot-brand .logo-mark{ background:var(--white); }
  .foot-brand .logo-mark::before{ border-color:var(--navy); }
  .foot-brand p{ font-size:14px; max-width:280px; margin:0 0 14px 0; }
  .foot-col h4{ color:var(--white); font-size:13.5px; font-weight:700; margin-bottom:14px; }
  .foot-col ul{ list-style:none; display:flex; flex-direction:column; gap:10px; font-size:14px; padding:0; margin:0; }
  .foot-col a:hover{ color:var(--white); }
  .foot-bottom{ padding:20px 0; font-size:12.5px; text-align:center; color:#7C87A0; }
</style>
</head>
<body>

<header>
  <nav class="wrap">
    <div class="logo"><div class="logo-mark"></div>Vitta Health</div>
    <div class="nav-links">
      <a href="#producto">Producto</a>
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#profesionales">Profesionales</a>
      <a href="#faq">Preguntas</a>
    </div>
    <a class="btn" href="mailto:info@vitta.health?subject=Quiero%20una%20demo%20de%20Vitta%20Health">Agenda tu demo gratis</a>
  </nav>
</header>

<section class="hero">
  <div class="wrap">
    <h1 class="headline">Deja de perder horas escribiendo notas después de cada consulta.</h1>
    <p class="sub">Vitta Health graba, transcribe y estructura la documentación clínica mientras atiendes — para que dejes el consultorio con la nota ya lista, no pendiente.</p>
    <div class="hero-ctas">
      <a class="btn" href="mailto:info@vitta.health?subject=Quiero%20una%20demo%20de%20Vitta%20Health">Agenda tu demo gratis</a>
      <a href="#como-funciona" class="link-arrow">Ver cómo funciona</a>
    </div>
    <div class="check-line">
      <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>Sin tarjeta de crédito</span>
      <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>Configuración en minutos</span>
      <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>Soporte en español</span>
    </div>

    <div class="calc-wrap vh-reveal" style="transition-delay:0ms;">
      <div class="calc-card">
        <div class="calc-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1D4ED8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg>
        </div>
        <div class="calc-headline">¿Cuántas horas podrías ahorrar al mes?</div>
        <div class="calc-label">¿Cuántas consultas atiendes al día?</div>
        <input type="range" min="1" max="40" value="15" id="consultasSlider" class="calc-slider">
        <div class="calc-scale"><span>1</span><span>40</span></div>
        <div class="calc-value" id="consultasValue">15 consultas al día</div>
        <div class="calc-divider"></div>
        <div class="calc-result">
          <div class="calc-result-num" id="horasResultado">81.2 h</div>
          <div class="calc-result-label">al mes, de vuelta para tus pacientes</div>
        </div>
        <div class="calc-source">Basado en un ahorro promedio de 15 minutos por nota clínica, medido con médicos beta de Vitta Health.</div>
      </div>
    </div>
  </div>
</section>

<section class="reframe">
  <div class="wrap">
