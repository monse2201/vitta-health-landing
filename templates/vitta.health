<section id="como-funciona">
  <div class="wrap">
    <div class="section-head vh-reveal">
      <h2>De la conversación a la nota lista, <em class="hl">en tres pasos</em>.</h2>
      <p>Sin escribir una sola palabra.</p>
    </div>
    <div class="how-layout">
      <div class="how-phone" style="opacity:0; animation: vhFadeInUp .6s ease .1s forwards;">
        <div class="phone-shell">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-appname">Vitta Health</div>
            <div class="phone-patient">Ana Rojas · Consulta general</div>
            <div class="phone-stage">

              <div class="phone-stage-panel visible" data-stage="0">
                <div class="phone-mic-wrap">
                  <div class="mic-ring"></div>
                  <div class="mic-ring ring2"></div>
                  <div class="mic-btn">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line></svg>
                  </div>
                </div>
                <div class="phone-waveform">
                  <span style="animation-delay:0ms;"></span>
                  <span style="animation-delay:80ms;"></span>
                  <span style="animation-delay:160ms;"></span>
                  <span style="animation-delay:240ms;"></span>
                  <span style="animation-delay:320ms;"></span>
                  <span style="animation-delay:400ms;"></span>
                  <span style="animation-delay:480ms;"></span>
                </div>
                <div class="phone-rec-label"><span class="rec-dot"></span>Capturando consulta</div>
              </div>

              <div class="phone-stage-panel" data-stage="1">
                <div class="phone-icon-circle">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1D4ED8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
                </div>
                <div class="phone-status-text">Analizando la conversación</div>
                <div class="dots-row"><span></span><span></span><span></span></div>
              </div>

              <div class="phone-stage-panel" data-stage="2">
                <div class="note-preview">
                  <div class="label">Plan</div>
                  <div class="text">Analgésico PRN, hemograma y TSH, control en 2 semanas.</div>
                </div>
                <div class="ready-check">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
                  Documentación estructurada
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <div class="how-steps">
        <div class="how-step vh-reveal active" data-step="0" style="transition-delay:0ms;">
          <div class="how-step-num">01</div>
          <div>
            <h3>Captura</h3>
            <p>Vitta Health registra y procesa la conversación entre el profesional y el paciente.</p>
          </div>
        </div>
        <div class="how-step vh-reveal" data-step="1" style="transition-delay:120ms;">
          <div class="how-step-num">02</div>
          <div>
            <h3>Analiza</h3>
            <p>Identifica la información clínica relevante dentro de la conversación.</p>
          </div>
        </div>
        <div class="how-step vh-reveal" data-step="2" style="transition-delay:240ms;">
          <div class="how-step-num">03</div>
          <div>
            <h3>Estructura</h3>
            <p>Genera automáticamente documentación clínica organizada y lista para revisión.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

