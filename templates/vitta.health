<script>
  var slider = document.getElementById('consultasSlider');
  var valueEl = document.getElementById('consultasValue');
  var resultEl = document.getElementById('horasResultado');
  function updateCalc(v) {
    valueEl.textContent = v + ' consultas al día';
    var minutosAhorradosPorNota = 15;
    var horas = Math.round((v * minutosAhorradosPorNota * 5 * 4.33) / 6) / 10;
    resultEl.textContent = horas + ' h';
  }
  slider.addEventListener('input', function (e) {
    updateCalc(parseInt(e.target.value, 10));
  });

  var revealObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('vh-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.vh-reveal').forEach(function (el) {
    revealObserver.observe(el);
  });

  function setActiveStep(step) {
    document.querySelectorAll('.how-step').forEach(function (el) {
      el.classList.toggle('active', parseInt(el.dataset.step, 10) === step);
    });
    document.querySelectorAll('.phone-stage-panel').forEach(function (el) {
      el.classList.toggle('visible', parseInt(el.dataset.stage, 10) === step);
    });
  }
  var howObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        setActiveStep(parseInt(entry.target.dataset.step, 10));
      }
    });
  }, { threshold: 0, rootMargin: '-45% 0px -45% 0px' });
  document.querySelectorAll('.how-step').forEach(function (el) {
    howObserver.observe(el);
  });
</script>

</body>
</html>
